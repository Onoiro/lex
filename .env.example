YANDEX_API_KEY=your_yandex_translate_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Global daily char budget across all users (translate + tts combined)
GLOBAL_DAILY_CHAR_LIMIT=300000
# App tokens for the X-App-Token header check (comma-separated, for rotation).
# Leave empty to disable token checking (e.g. during rollout).
# APP_TOKENS=token1,token2
# CORS whitelist of client origins (comma-separated). Defaults:
# https://lex.2-way.ru, https://localhost, capacitor://localhost,
# http://tauri.localhost, tauri://localhost
# Add dev origins here if needed, e.g. http://localhost:5173
# ALLOWED_ORIGINS=
